# ── Public (exposed to the browser) ─────────────────────────────
# Reown (WalletConnect) project ID — free at https://dashboard.reown.com
NEXT_PUBLIC_REOWN_PROJECT_ID=

# The exact URL eroFi is served from. Wallets compare this with the page
# origin and warn users when they differ (phishing protection).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: your own Solana RPC (Helius, Triton, QuickNode…). Leave empty to
# use the RPC provided by Reown AppKit.
NEXT_PUBLIC_SOLANA_RPC_URL=

# ── Server only (never prefix with NEXT_PUBLIC_) ────────────────
# Relay API key — required by Relay since 2 Oct 2026. Request one at
# https://relay.link (Developers). Used only inside /api/relay/* routes.
RELAY_API_KEY=

# Relay API base URL (keep default unless Relay tells you otherwise)
RELAY_API_URL=https://api.relay.link

# Optional: identifies your app in Relay analytics / fee programs
RELAY_REFERRER=erofi
